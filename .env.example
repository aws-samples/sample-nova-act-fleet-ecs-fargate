# Copy this file to `.env` at the project root and fill in real values.
# Anything in `.env` is loaded by examples via `python-dotenv` (load_dotenv()).

# Nova Act API key — get one at https://nova.amazon.com/act?tab=dev_tools
NOVA_ACT_API_KEY=replace-me-with-your-real-key

# Optional: AWS credentials for CloudWatch/S3/SNS calls made by the framework.
# If you have them configured via `aws configure` or an SSO session, you can
# leave these unset and boto3 will pick them up automatically.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
